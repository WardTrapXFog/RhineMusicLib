{
  "name": "rhine-music-lib",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-rolling-number.mjs",
    "predev": "node scripts/patch-rolling-number.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/patch-rolling-number.mjs",
    "build": "tsc && vite build && node scripts/build-pwa.mjs",
    "format": "prettier --write src/music-cover.ts src/music-player.ts src/library-setup.ts src/data.ts src/main.ts scripts/music-library.mjs index.html package.json",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@kitlangton/rolling-number": "0.4.1",
    "music-metadata": "^11.16.1",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@types/three": "^0.183.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
